{% extends 'admin.twig' %}

{% set title %}{{ 'McpServer_ConnectPageTitle'|translate }}{% endset %}

{% block content %}
<div class="mcpServerConnect">
    <div class="card">
        <div class="card-content">
            <h2>{{ 'McpServer_ConnectPageTitle'|translate }}</h2>
            <p>{{ 'McpServer_ConnectIntro'|translate }}</p>
            {% if isMcpEnabled %}
                <h3>{{ 'McpServer_ConnectWhatYouNeedTitle'|translate }}</h3>
                <ul class="browser-default">
                    <li>{{ 'McpServer_ConnectNeedEndpoint'|translate }}</li>
                    <li>{{ 'McpServer_ConnectNeedToken'|translate('<code>', '</code>')|raw }}</li>
                </ul>
            {% endif %}
            {% if not isMcpEnabled %}
                <div class="alert alert-warning">
                    {% if canEnableMcp %}
                        {{ 'McpServer_ConnectMcpDisabledCanEnable'|translate('<a href="' ~ mcpSettingsUrl ~ '">', '</a>')|raw }}
                    {% else %}
                        {{ 'McpServer_ConnectMcpDisabledNoPermission'|translate }} {{ 'General_PleaseContactYourPiwikAdministrator'|translate }}
                    {% endif %}
                </div>
            {% endif %}
        </div>
        {% if isMcpEnabled %}
        <div class="card-action">
            {{ 'General_GoTo2'|translate }}:
            <a href="#/endpoint">{{ 'McpServer_ConnectEndpointTitle'|translate }}</a>
            <a href="#/set-up-client">{{ 'McpServer_ConnectInClientTitle'|translate }}</a>
            <a href="#/troubleshooting">{{ 'McpServer_ConnectTroubleshootingTitle'|translate }}</a>
        </div>
        {% endif %}
    </div>

    {% if isMcpEnabled %}
        <div vue-entry="CoreHome.ContentBlock" content-title="{{ 'McpServer_ConnectEndpointTitle'|translate }}" anchor="endpoint">
            <p>{{ 'McpServer_ConnectEndpointDescription'|translate }}</p>
            <p><code class="mcpServerLongCode">{{ mcpApiEndpoint }}</code></p>
        </div>

        <div vue-entry="CoreHome.ContentBlock" content-title="{{ 'McpServer_ConnectInClientTitle'|translate }}" anchor="set-up-client">
            <ol>
                <li>{{ 'McpServer_ConnectInClientStepOpenSettings'|translate }}</li>
                <li>{{ 'McpServer_ConnectInClientStepEndpoint'|translate }} <code class="mcpServerLongCode">{{ mcpApiEndpoint }}</code></li>
                <li>
                    {{ 'McpServer_ConnectInClientStepAuth'|translate }}
                    <ul class="browser-default">
                        <li>{{ 'McpServer_ConnectInClientAuthType'|translate('<strong>', '</strong>')|raw }}</li>
                        <li>{{ 'McpServer_ConnectInClientAuthToken'|translate('<strong>', '</strong>', '<code>', '</code>')|raw }}</li>
                    </ul>
                </li>
                <li>{{ 'McpServer_ConnectInClientStepInitialize'|translate }}</li>
            </ol>
            <h3>{{ 'McpServer_ConnectTokenTitle'|translate }}</h3>
            <p>{{ 'McpServer_ConnectInClientTokenHelp'|translate('<a href="' ~ userSecurityUrl ~ '">', '</a>', '<code>', '</code>')|raw }}</p>
        </div>

        <div vue-entry="CoreHome.ContentBlock" content-title="{{ 'McpServer_ConnectTroubleshootingTitle'|translate }}" anchor="troubleshooting">
            <ul class="browser-default">
                <li>
                    <strong><code>401</code></strong>: {{ 'McpServer_ConnectTroubleshooting401'|translate }}
                    <br />
                    {{ 'McpServer_ConnectTroubleshooting401Action'|translate('<code>', '</code>')|raw }}
                </li>
                <li>
                    <strong><code>403</code></strong>: {{ 'McpServer_ConnectTroubleshooting403'|translate }}
                    <br />
                    {{ 'McpServer_ConnectTroubleshooting403Action'|translate }}
                </li>
                <li>
                    <strong><code>400</code></strong>: {{ 'McpServer_ConnectTroubleshooting400'|translate }}
                    <br />
                    {{ 'McpServer_ConnectTroubleshooting400Action'|translate }}
                </li>
            </ul>
        </div>
    {% endif %}
</div>
{% endblock %}
