{
  "require": {
    "php": "^8.1",
    "mcp/sdk": "^0.8.0",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1"
  },
  "replace": {
    "psr/container": "*",
    "psr/event-dispatcher": "*",
    "psr/log": "*"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    },
    "platform": {
      "php": "8.1.0"
    }
  }
}
